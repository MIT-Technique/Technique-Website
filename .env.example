# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session encryption (iron-session, must be >= 32 characters)
SESSION_PASSWORD=your-session-password-at-least-32-chars

# Encryption for senior bios
CRYPTR_SECRET=your-cryptr-secret

# MongoDB (legacy bio data)
DB_URI=mongodb+srv://...

# Email sending (nodemailer)
GOOGLE_PASSWORD=your-google-app-password
